rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document security: Only the owner can read or write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Nested transactions subcollection: Only the owner can read or write
      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Nested quests subcollection: Only the owner can read or write
      match /quests/{questId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Nested IPO profiles subcollection: Only the owner can read or write
      match /ipo_profiles/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Nested capital allocations subcollection: Only the owner can read or write
      match /capital_allocations/{allocId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Nested IPO applications subcollection: Only the owner can read or write
      match /ipo_applications/{appId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Nested IPO trades subcollection: Only the owner can read or write
      match /ipo_trades/{tradeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
